.identity-page {
    padding: 24rpx 28rpx 80rpx;
}

.status-card {
    padding: 44rpx 36rpx;
    text-align: center;
}

.status-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 92rpx;
    height: 92rpx;
    margin: 0 auto 24rpx;
    border-radius: 50%;
    font-size: 44rpx;
    font-weight: 900;
}

.status-icon.success {
    color: #047857;
    background: #d1fae5;
}

.status-icon.pending {
    color: #b45309;
    background: #fef3c7;
}

.status-title {
    color: #111827;
    font-size: 34rpx;
    font-weight: 800;
}

.status-desc {
    margin-top: 14rpx;
    color: #4b5563;
    font-size: 28rpx;
}

.status-meta {
    margin-top: 14rpx;
    line-height: 1.7;
}

.privacy-card,
.rejected-card {
    margin-top: 24rpx;
    padding: 26rpx 30rpx;
    border-radius: 20rpx;
    color: #6b7280;
    font-size: 24rpx;
    line-height: 1.7;
    background: #ffffff;
}

.rejected-card {
    color: #991b1b;
    background: #fef2f2;
}

.form-card {
    padding: 34rpx 30rpx;
}

.form-title {
    color: #111827;
    font-size: 34rpx;
    font-weight: 800;
}

.form-desc {
    margin-top: 12rpx;
    margin-bottom: 24rpx;
    color: #6b7280;
    font-size: 25rpx;
    line-height: 1.65;
}

.identity-input {
    box-sizing: border-box;
    width: 100%;
    height: 84rpx;
    padding: 0 22rpx;
    border: 1rpx solid #e5e7eb;
    border-radius: 14rpx;
    color: #111827;
    font-size: 28rpx;
    background: #f9fafb;
}

.consent-title {
    margin-top: 30rpx;
    color: #374151;
    font-size: 25rpx;
    font-weight: 700;
}

.consent-box {
    box-sizing: border-box;
    height: 220rpx;
    margin-top: 12rpx;
    padding: 20rpx;
    border-radius: 14rpx;
    color: #6b7280;
    font-size: 23rpx;
    line-height: 1.7;
    background: #f9fafb;
}

.consent-row {
    display: flex;
    align-items: flex-start;
    gap: 12rpx;
    margin-top: 22rpx;
    color: #4b5563;
    font-size: 24rpx;
    line-height: 1.55;
}

.submit-button {
    margin-top: 28rpx;
}

.policy-note {
    margin-top: 24rpx;
    color: #9ca3af;
    font-size: 22rpx;
    text-align: center;
}
