<nav-bar title="实名认证" back />

<view class="page identity-page">
    <view wx:if="{{loading}}" class="loading-wrap">正在加载实名状态…</view>

    <block wx:elif="{{isVerified}}">
        <view class="card status-card">
            <view class="status-icon success">✓</view>
            <view class="status-title">实名认证已通过</view>
            <view class="status-desc">{{verification.realName}} · {{verification.idNumberMasked}}</view>
            <view class="tiny muted status-meta">认证时间 {{verification.verifiedAt || verification.reviewedAt}}</view>
        </view>
        <view class="privacy-card">身份证件号码已加密存储，仅在实名核验、风控和争议处理时按最小权限访问。</view>
    </block>

    <block wx:elif="{{isPending}}">
        <view class="card status-card">
            <view class="status-icon pending">◷</view>
            <view class="status-title">实名资料审核中</view>
            <view class="status-desc">{{verification.realName}} · {{verification.idNumberMasked}}</view>
            <view class="tiny muted status-meta">运营人员会通过微信实名、持牌核验服务或人工方式核对，通常 1 个工作日内完成。</view>
        </view>
    </block>

    <block wx:else>
        <view wx:if="{{isRejected}}" class="card rejected-card">
            <view class="status-title">上次核验未通过</view>
            <view class="status-desc">{{reviewNote || '请核对姓名和身份证件号码后重新提交。'}}</view>
        </view>

        <view class="card form-card">
            <view class="form-title">提交实名资料</view>
            <view class="form-desc">用于确认交易双方真实身份、账号安全和争议处理。身份证件号码只在服务端加密保存，不以明文落库。</view>

            <view class="form-label">真实姓名</view>
            <input class="identity-input" maxlength="40" value="{{realName}}" data-field="realName" bindinput="onFieldInput" placeholder="须与身份证件一致" />

            <view class="form-label">身份证件号码</view>
            <input class="identity-input" maxlength="18" value="{{idNumber}}" data-field="idNumber" bindinput="onFieldInput" placeholder="18 位身份证件号码" />

            <view class="consent-title">实名核验授权说明</view>
            <scroll-view class="consent-box" scroll-y>
                <text>{{consentContent}}</text>
            </scroll-view>
            <checkbox-group bindchange="onAgreementChange">
                <label class="consent-row">
                    <checkbox value="agreed" checked="{{agreed}}" color="#0f766e" />
                    <text>我已阅读并同意上述实名核验授权说明</text>
                </label>
            </checkbox-group>

            <button class="btn-primary submit-button" loading="{{submitting}}" disabled="{{submitting || !agreed}}" bindtap="submit">提交核验</button>
        </view>
    </block>

    <view class="policy-note">平台不会要求提供微信密码、支付密码或短信验证码。</view>
</view>
