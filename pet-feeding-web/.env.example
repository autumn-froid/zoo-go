# Go API base URL for the browser.
# Local: hit the API directly.
# Vercel / same-origin proxy: leave EMPTY and set API_PROXY_ORIGIN instead
#   (browser calls /v1 on the site origin; Next rewrites to the ECS).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Server-only rewrite target (not exposed to the browser). Used on Vercel.
# Prefer Caddy on :80: http://1.92.99.17
# Or expose API publicly: http://1.92.99.17:8080
# API_PROXY_ORIGIN=http://1.92.99.17

# Public site origin for SEO (canonical / sitemap / Open Graph).
# On Vercel set to your deployment URL, e.g. https://pet-feeding-web.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
