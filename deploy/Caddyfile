:80 {
	encode gzip zstd

	handle /v1* {
		reverse_proxy api:8080
	}
	handle /admin* {
		reverse_proxy api:8080
	}
	handle /uploads* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
