# Copy to deploy/.env on the ECS host and fill in real values.
# Never commit deploy/.env.

ZOO_IMAGE=ghcr.io/connor-wj-kang/zoo-go:latest
WEB_IMAGE=ghcr.io/connor-wj-kang/zoo-go/web:latest

# Loopback-only API port (SSH tunnel / local debug). Public HTTPS is via Caddy.
API_PORT=8080

# Public site (baked into the web image at build; also set here for server-side fallback).
NEXT_PUBLIC_SITE_URL=https://homepet.cn
# Empty = same-origin /v1 through Caddy (recommended).
NEXT_PUBLIC_API_BASE_URL=

# Go API public origin (signed media / WeChat image review). Same host via Caddy.
PUBLIC_BASE_URL=https://homepet.cn

# Leave WeChat pay fields empty until fully configured; any non-empty
# pay field enables payment init and will fail startup if incomplete.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=
WECHAT_REFUND_NOTIFY_URL=

DEV_AUTH=false
ADMIN_TOKEN=

# Required before the API starts. Generate each value once with:
#   openssl rand -hex 32
# Back up the keys with the database backup. Losing the encryption key makes
# existing identity and student verification data unrecoverable.
PII_ENCRYPTION_KEY=
PII_HASH_KEY=

O2_USER=root@example.com
O2_PASS=change-me
O2_PORT=5080

OTEL_SERVICE_NAME=zoo-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default
# printf '%s' "$O2_USER:$O2_PASS" | base64 -w0
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20REPLACE_ME
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod
