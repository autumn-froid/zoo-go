.agreement-page {
    padding: 24rpx 28rpx 80rpx;
}

.agreement-card {
    padding: 30rpx;
}

.agreement-title {
    color: #111827;
    font-size: 34rpx;
    font-weight: 800;
}

.agreement-version {
    margin-top: 12rpx;
    color: #9ca3af;
    font-size: 21rpx;
    word-break: break-all;
}

.agreement-content {
    box-sizing: border-box;
    height: 58vh;
    margin-top: 24rpx;
    padding: 22rpx;
    border-radius: 16rpx;
    color: #374151;
    font-size: 25rpx;
    line-height: 1.8;
    white-space: pre-wrap;
    background: #f9fafb;
}

.checklist-card {
    margin-top: 22rpx;
    padding: 28rpx 30rpx;
}

.checklist-title {
    margin-bottom: 14rpx;
    color: #111827;
    font-size: 27rpx;
    font-weight: 700;
}

.checklist-item {
    display: flex;
    align-items: flex-start;
    gap: 12rpx;
    padding: 10rpx 0;
    color: #4b5563;
    font-size: 24rpx;
    line-height: 1.65;
}

.checklist-mark {
    flex-shrink: 0;
    color: #0f766e;
    font-weight: 900;
}

.agreement-footnote {
    margin-top: 24rpx;
    color: #9ca3af;
    font-size: 22rpx;
    line-height: 1.65;
    text-align: center;
}
